{
  "_comment": "OpenCode configuration for the receipt-per-edge kit. Wires the attach-receipts skill and a verify step over the Talus Robotics scenario (sample-input.md / schema.example.json). Copy to opencode.json and adjust paths if you move the kit.",
  "version": "1.0",
  "name": "receipt-per-edge-opencode",
  "description": "Attaches source_doc/extraction_run_id/schema_version receipts to every written edge, refusing any edge missing one, with independent verification of the output",
  "tools": [
    {
      "name": "attach-receipts",
      "type": "skill",
      "path": "skills/attach-receipts/SKILL.md"
    }
  ],
  "workflow": {
    "steps": [
      {
        "name": "attach",
        "tool": "attach-receipts",
        "input": {
          "document": "../sample-input.md",
          "schema": "../schema.example.json"
        },
        "output": "output.json"
      },
      {
        "name": "verify",
        "tool": "attach-receipts",
        "mode": "verify",
        "input": {
          "output": "output.json",
          "schema": "../schema.example.json"
        },
        "description": "Re-runs the same skill in verify mode (see SKILL.md's Mode: verify section) to independently re-check output.json against schema.example.json, mirroring the Claude Code graph-verifier subagent."
      }
    ]
  }
}
